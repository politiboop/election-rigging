---
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/lora/400-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import actions from '../data/actions.json';
import history from '../data/history.json';

const LAST_UPDATED = 'July 30, 2026';

const STATUS = {
  active:     { label: 'In Effect',     color: 'var(--st-active)' },
  court:      { label: 'In Court',      color: 'var(--st-court)' },
  threatened: { label: 'Threatened',    color: 'var(--st-threat)' },
  record:     { label: 'On the Record', color: 'var(--st-record)' },
  blocked:    { label: 'Blocked',       color: 'var(--st-blocked)' },
};
const STATUS_ORDER = ['active', 'court', 'threatened', 'record', 'blocked'];

const CATS = {
  machinery: 'Seizing the Machinery',
  data:      'The Voter Data Dragnet',
  force:     'Force at the Polls',
  ballot:    'The Ballot Box',
  maps:      'Redrawing the Maps',
  referees:  'Replacing the Referees',
  narrative: 'The Narrative War',
};

const sorted = [...actions].sort((a, b) => b.date.localeCompare(a.date));
const chrono = [...actions].sort((a, b) => a.date.localeCompare(b.date));
const total = actions.length;

const MONTHS_LONG = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const monthLabel = (d) => { const [y, m] = d.split('-').map(Number); return `${MONTHS_LONG[m - 1]} ${y}`; };
const timelineMonths = [];
for (const a of chrono) {
  const key = a.date.slice(0, 7);
  if (!timelineMonths.length || timelineMonths[timelineMonths.length - 1].key !== key) {
    timelineMonths.push({ key, label: monthLabel(a.date), items: [] });
  }
  timelineMonths[timelineMonths.length - 1].items.push(a);
}
const since2026 = chrono.filter((a) => a.date >= '2026-01-01').length;

const LEGAL_LABELS = {
  ruled: 'Ruled Unlawful',
  statute: 'Prohibited by Law',
  constitution: 'Constitutional Conflict',
};
const unprecCount = actions.filter((a) => a.unprecedented).length;
const legalCount = actions.filter((a) => a.legal).length;

const doubtCount = actions.filter((a) => a.doubt).length;
const historySorted = [...history].sort((a, b) => a.date.localeCompare(b.date));
const historyYears = [];
for (const h of historySorted) {
  const y = h.date.slice(0, 4);
  if (!historyYears.length || historyYears[historyYears.length - 1].year !== y) historyYears.push({ year: y, items: [] });
  historyYears[historyYears.length - 1].items.push(h);
}
const doubtTotal = doubtCount + history.length;
const outlet = (t) => t.split(':')[0];
const statusCounts = Object.fromEntries(STATUS_ORDER.map(s => [s, actions.filter(a => a.status === s).length]));
const catCounts = Object.fromEntries(Object.keys(CATS).map(c => [c, actions.filter(a => a.category === c).length]));
const sourceCount = actions.reduce((n, a) => n + a.sources.length, 0);

const fmtDate = (d) => {
  const [y, m, day] = d.split('-').map(Number);
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  return `${months[m - 1]} ${day}, ${y}`;
};

const description = `A sourced, single-page record of ${total} documented actions to tilt the 2026 midterm elections before they happen: who counts the votes, who certifies them, who can cast them, and who is watching.`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Rigged Before the Vote — Tracking the Campaign Against the 2026 Midterms</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Rigged Before the Vote" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>

    <header class="topbar">
      <div class="wrap topbar-inner">
        <a class="wordmark" href="#top">Rigged <em>Before</em> the Vote</a>
        <nav class="topnav" aria-label="Sections">
          <a href="#record">The Record</a>
          <a href="#prehistory">The Prehistory</a>
          <a href="#sequence">The Sequence</a>
          <a href="#pattern">The Pattern</a>
          <a href="#watch">What to Watch</a>
          <a href="#protect">Protect the Vote</a>
          <a href="#method">Method</a>
        </nav>
        <span class="countdown-chip"><strong id="days-out">—</strong> days to the midterms</span>
      </div>
    </header>

    <main id="top">

      <!-- ── HERO ─────────────────────────────────────────────────────── -->
      <div class="hero">
        <div class="wrap">
          <p class="eyebrow">A documented record · Updated {LAST_UPDATED}</p>
          <h1>Rigged <span class="accent">before</span><br />the vote.</h1>
          <p class="deck">
            In 2020, they tried to overturn an election <strong>after losing it</strong>.
            The pattern documented here runs the other direction: change who counts the votes, who
            certifies them, who can cast them, and who is watching — <strong>before a single ballot
            is cast</strong>.
          </p>
          <p class="deck">
            Below: {total} documented election-interfering actions. Every fact is sourced, every
            opinion is labeled, and the unprecedented and the unlawful are flagged as such, with
            the basis stated.
          </p>

          <div class="statrow">
            <button class="stat stat-btn" data-goto-all><div class="num" data-count={total}>0</div><div class="lbl">Documented actions</div></button>
            <button class="stat stat-btn" data-tone="active" data-goto-status="active"><div class="num" data-count={statusCounts.active}>0</div><div class="lbl">In effect now</div></button>
            <button class="stat stat-btn" data-tone="court" data-goto-status="court"><div class="num" data-count={statusCounts.court}>0</div><div class="lbl">Being fought in court</div></button>
            <button class="stat stat-btn" data-tone="blocked" data-goto-status="blocked"><div class="num" data-count={statusCounts.blocked}>0</div><div class="lbl">Blocked or failed</div></button>
            <button class="stat stat-btn" data-tone="unprec" data-goto-flag="unprec"><div class="num" data-count={unprecCount}>0</div><div class="lbl">Without historical precedent</div></button>
            <button class="stat stat-btn" data-tone="legal" data-goto-flag="legal"><div class="num" data-count={legalCount}>0</div><div class="lbl">Unlawful or in constitutional conflict</div></button>
            <div class="stat" data-tone="countdown"><div class="num" id="days-out-big">—</div><div class="lbl">Days until Nov 3, 2026</div></div>
          </div>

          <div class="doubt-band">
            <div class="doubt-num" data-count={doubtTotal}>0</div>
            <div class="doubt-copy">
              <strong>Documented instances of Trump publicly undermining trust in American elections.</strong>
              <span>
                {history.length} from the 2020–2025 record, in <a href="#prehistory">the prehistory</a> ·
                {doubtCount} in the 2026 record — <button class="linklike" id="doubt-filter-btn">see them</button>.
                Counted per documented entry, so this is conservative: CREW alone logged 500+ Truth Social posts repeating 2020
                conspiracy claims. Criteria in <a href="#method">Method</a>.
              </span>
            </div>
          </div>

          <blockquote class="hero-quote">
            <p>“The taking of democracy does not occur in one fell swoop; it is chipped away piece-by-piece until there is nothing left.”</p>
            <cite>U.S. District Judge David O. Carter, dismissing a DOJ voter-roll lawsuit, January 2026</cite>
          </blockquote>
        </div>
      </div>

      <!-- ── HOW TO READ ──────────────────────────────────────────────── -->
      <section id="readme" aria-label="How to read this page">
        <div class="wrap">
          <div class="sec-head">
            <p class="kicker">How to read this page</p>
            <h2>Facts and takes are separated. On purpose.</h2>
          </div>
          <div class="readme-grid">
            <div class="readme-card facts">
              <h3>The facts</h3>
              <p>
                Every card below documents an action with dates, names, and direct quotes, and links to
                its sources — {sourceCount} citations across major outlets, court records, and official
                statements, including right-leaning outlets where they covered the story. If a claim is
                contested or single-sourced, the card says so. We would rather publish nothing than
                publish something wrong.
              </p>
            </div>
            <div class="readme-card take">
              <h3>Our take</h3>
              <p>
                When we editorialize, it looks like this block: labeled, set apart, and easy to skip.
                Here is our take, up front: taken together, this record describes a sustained effort to
                decide the 2026 midterms before they are held. You do not have to accept that conclusion —
                the sources are all here. Read them and decide for yourself.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ── SCOREBOARD ───────────────────────────────────────────────── -->
      <section id="scoreboard" aria-label="Status scoreboard">
        <div class="wrap">
          <div class="sec-head">
            <p class="kicker">Where things stand</p>
            <h2>The scoreboard</h2>
            <p class="sub">Each of the {total} documented actions carries a status. The proportions tell the story: most of this is not hypothetical.</p>
          </div>

          <div class="breakdown">
            <div class="breakdown-bar" role="img" aria-label={STATUS_ORDER.map(s => `${STATUS[s].label}: ${statusCounts[s]}`).join(', ')}>
              {STATUS_ORDER.map(s => (
                <div class="seg" style={`flex:${statusCounts[s]};background:${STATUS[s].color}`} title={`${STATUS[s].label}: ${statusCounts[s]}`}></div>
              ))}
            </div>
            <div class="breakdown-legend">
              {STATUS_ORDER.map(s => (
                <span class="legend-item">
                  <span class="swatch" style={`background:${STATUS[s].color}`}></span>
                  <strong>{statusCounts[s]}</strong> {STATUS[s].label}
                </span>
              ))}
            </div>
          </div>

          <div class="flag-tiles">
            <button class="flag-tile" data-goto-flag="unprec">
              <div class="n">{unprecCount}</div>
              <div class="t"><strong>Have no historical precedent.</strong> Actions with no equivalent in the American record, per the officials, experts, and reporting each card cites.</div>
            </button>
            <button class="flag-tile is-legal" data-goto-flag="legal">
              <div class="n">{legalCount}</div>
              <div class="t"><strong>Are unlawful or in constitutional conflict.</strong> Ruled against by courts, prohibited by statute or standing court order, or in direct conflict with constitutional text.</div>
            </button>
          </div>

          <div class="cat-tiles">
            {Object.entries(CATS).map(([slug, label]) => (
              <button class="cat-tile" data-goto-cat={slug}>
                <div class="n">{catCounts[slug]}</div>
                <div class="t">{label}</div>
              </button>
            ))}
          </div>
        </div>
      </section>

      <!-- ── THE RECORD ───────────────────────────────────────────────── -->
      <section id="record" aria-label="The record">
        <div class="wrap">
          <div class="sec-head">
            <p class="kicker">The evidence wall</p>
            <h2>The record</h2>
            <p class="sub">Filter by category or status. Click any card for the full facts, our labeled take where we have one, and every source.</p>
          </div>
        </div>

        <div class="filterbar">
          <div class="wrap">
            <div class="chiprow">
              <span class="rowlbl">Category</span>
              <button class="chip is-on" data-cat="all">All</button>
              {Object.entries(CATS).map(([slug, label]) => (
                <button class="chip" data-cat={slug}>{label}</button>
              ))}
              <span class="result-count"><span id="shown-count">{total}</span> / {total} shown</span>
            </div>
            <div class="chiprow">
              <span class="rowlbl">Status</span>
              <button class="chip is-on" data-status="all">All</button>
              {STATUS_ORDER.map(s => (
                <button class="chip" data-status={s} style={`--chip-c:${STATUS[s].color}`}>{STATUS[s].label}</button>
              ))}
              <button class="sort-toggle" id="sort-toggle" style="margin-left:auto">Newest first ↓</button>
            </div>
            <div class="chiprow">
              <span class="rowlbl">Flags</span>
              <button class="chip is-on" data-flag="all">All</button>
              <button class="chip" data-flag="unprec">Unprecedented ({unprecCount})</button>
              <button class="chip" data-flag="legal">Unlawful / constitutional conflict ({legalCount})</button>
              <button class="chip" data-flag="doubt">Undermined election trust ({doubtCount})</button>
            </div>
          </div>
        </div>

        <div class="wrap">
          <div class="cards" id="cards">
            {sorted.map((a) => (
              <details class="card" id={a.id} data-status={a.status} data-cat={a.category} data-date={a.date} data-unprec={a.unprecedented ? '1' : undefined} data-legal={a.legal ? '1' : undefined} data-doubt={a.doubt ? '1' : undefined}>
                <summary>
                  <div class="card-meta">
                    <span class="status-chip">{STATUS[a.status].label}</span>
                    {a.unprecedented && <span class="flag-chip unprec">Unprecedented</span>}
                    {a.legal && <span class="flag-chip legal">{LEGAL_LABELS[a.legal.level]}</span>}
                    <span class="cat-chip">{CATS[a.category]}</span>
                    <span class="date">{fmtDate(a.date)}</span>
                  </div>
                  <h3>{a.title}</h3>
                  <p class="peek">{a.facts[0]}</p>
                  <p class="expand-hint">
                    <span class="closed-txt">▸ {a.facts.length} facts · {a.sources.length} sources{a.take ? ' · our take' : ''}</span>
                    <span class="open-txt">▾ Collapse</span>
                  </p>
                </summary>
                <div class="card-body">
                  <ul>
                    {a.facts.map((f) => <li>{f}</li>)}
                  </ul>
                  {a.unprecedented && (
                    <p class="flag-line unprec"><strong>Why it's unprecedented:</strong> {a.unprecedented}</p>
                  )}
                  {a.legal && (
                    <p class="flag-line legal"><strong>{LEGAL_LABELS[a.legal.level]}:</strong> {a.legal.basis}</p>
                  )}
                  {a.take && (
                    <div class="take-block">
                      <p class="take-lbl">Our take — opinion, not reporting</p>
                      <p>{a.take}</p>
                    </div>
                  )}
                  <p class="src-lbl">Sources</p>
                  <ul class="src-list">
                    {a.sources.map((s) => (
                      <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.text} ↗</a></li>
                    ))}
                  </ul>
                  <button class="share-btn" data-share={a.id} type="button">Copy link to this entry</button>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- ── THE PREHISTORY ───────────────────────────────────────────── -->
      <section id="prehistory" aria-label="The prehistory">
        <div class="wrap">
          <div class="sec-head">
            <p class="kicker">2020–2025 · Before this record</p>
            <h2>The prehistory</h2>
            <p class="sub">
              The 2026 campaign did not start in 2026. These are the documented precedents — the same
              claims, aimed at elections he had already run in. Every entry links to primary sources,
              and all {history.length} count toward the trust counter at the top of the page.
            </p>
          </div>

          <div class="history-block">
            {historyYears.map((y) => (
              <div class="tl-month">
                <h3 class="tl-month-head is-history">{y.year} <span class="tl-count">{y.items.length} {y.items.length === 1 ? 'entry' : 'entries'}</span></h3>
                <ul class="tl-list is-history">
                  {y.items.map((h) => (
                    <li class="tl-item is-history">
                      <span class="tl-date">{fmtDate(h.date).replace(/, \d{4}$/, '')}</span>
                      <div class="tl-hist-body">
                        <span class="tl-hist-title">{h.title}</span>
                        <p class="tl-hist-summary">{h.summary}</p>
                        <p class="tl-hist-sources">
                          {h.sources.map((s) => (
                            <a href={s.url} target="_blank" rel="noopener noreferrer" title={s.text}>{outlet(s.text)} ↗</a>
                          ))}
                        </p>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ── THE SEQUENCE ─────────────────────────────────────────────── -->
      <section id="sequence" aria-label="The sequence">
        <div class="wrap">
          <div class="sec-head">
            <p class="kicker">In order</p>
            <h2>The sequence</h2>
            <p class="sub">
              Every documented action, oldest first — <strong>{since2026} of {total}</strong> have
              come since January 2026. Click any entry to open its full record, with sources, above.
            </p>
          </div>

          <div class="timeline">
            {timelineMonths.map((m) => (
              <div class="tl-month">
                <h3 class="tl-month-head">{m.label} <span class="tl-count">{m.items.length} {m.items.length === 1 ? 'action' : 'actions'}</span></h3>
                <ul class="tl-list">
                  {m.items.map((a) => (
                    <li class="tl-item" data-status={a.status}>
                      <span class="tl-date">{fmtDate(a.date).replace(/, \d{4}$/, '')}</span>
                      <a class="tl-title" href={'#' + a.id}>{a.title}</a>
                      <span class="tl-status">{STATUS[a.status].label}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ── THE PATTERN ──────────────────────────────────────────────── -->
      <section id="pattern" aria-label="The pattern">
        <div class="wrap">
          <div class="sec-head">
            <p class="kicker">Reading the record</p>
            <h2>The pattern</h2>
          </div>
          <span class="analysis-note">Analysis — our interpretation of the sourced record above</span>
          <div class="prose">
            <p>
              Take the {total} cards above as one story and a shape emerges. The machinery moves first:
              ballots seized, the certification agency emptied, the post office deputized. The data
              comes next: voter files demanded from every state that will hand them over, and sued for
              where they won't. Then the people: the officials who protected 2020 replaced, the analysts
              who refuse reassigned or fired, election deniers running for the offices that certify the
              next race. And over all of it, the narrative — <em>rigged, stolen, corrupt</em> — repeated
              until any result that goes the wrong way arrives pre-delegitimized.
            </p>
            <p>
              The record also shows the counterforce. Courts have ruled against the voter-data campaign
              nine straight times, five of those rulings from Trump-appointed judges. States have refused.
              A bipartisan commission referred the world's richest man to prosecutors. The system is not
              gone — it is under load, and some of it is holding.
            </p>
            <p class="big-line">He doesn't need a coup if he controls who counts, who certifies, and who can vote. He just needs to call it an election.</p>
            <p>
              That sentence is our thesis, and it is an opinion. The {sourceCount} sources above are not.
            </p>
          </div>
        </div>
      </section>

      <!-- ── WHAT TO WATCH ────────────────────────────────────────────── -->
      <section id="watch" aria-label="What to watch">
        <div class="wrap">
          <div class="sec-head">
            <p class="kicker">Dated triggers</p>
            <h2>What to watch</h2>
            <p class="sub">The record above is history. These are the dates and open threats where it becomes the future.</p>
          </div>
          <ul class="watch-list">
            <li>
              <span class="watch-when">By Aug 3, 2026</span>
              <span class="watch-what"><strong>The Supreme Court mail-ballot deadline.</strong> On July 27 the DOJ asked the Supreme Court, on its emergency docket, to let the mail-voting order take effect in the 23 states that blocked it. The Court ordered those states to respond by August 3. A single emergency order could decide whether the federal government screens the nation's mail ballots this fall. <a href="#mail-voting-eo">See the card</a>.</span>
            </li>
            <li>
              <span class="watch-when">Before Aug recess</span>
              <span class="watch-what"><strong>The SAVE Act deadline.</strong> Trump is pressing the Senate to pass the SAVE Act, or "TERMINATE THE FILIBUSTER," before the August recess; Majority Leader Thune says he has the votes for neither. Watch whether the stalled bill moves. <a href="#save-act-hostage">See the card</a>.</span>
            </li>
            <li>
              <span class="watch-when">By late Aug 2026</span>
              <span class="watch-what"><strong>The "national emergency" watch.</strong> Steve Bannon said in late July he believes Trump will declare a national emergency by late August, claiming there will be "enough evidence by mid-August" of election fraud, the fraud courts, Barr, and CISA all found does not exist. Trump denied considering it. <a href="#emergency-powers-track">See the card</a>.</span>
            </li>
            <li>
              <span class="watch-when">~Aug 23, 2026</span>
              <span class="watch-what"><strong>The Musk charging decision.</strong> The Brown County, Wisconsin district attorney has 40 days from the July 14 referral to report back on election-bribery charges over the $1 million voter checks. <a href="#musk-wisconsin-bribery">See the card</a>.</span>
            </li>
            <li>
              <span class="watch-when">Mid-Sept 2026</span>
              <span class="watch-what"><strong>The mail-ballot gate.</strong> The USPS rule must be implemented before ballot mailing begins. If it survives court, the post office starts deciding which states' ballots it will carry. <a href="#usps-ballot-refusal">See the card</a>.</span>
            </li>
            <li>
              <span class="watch-when">Open threat</span>
              <span class="watch-what"><strong>Patel's promised arrests.</strong> The FBI director announced 2020-related arrests "coming soon" in April. No targets or crimes have been named. The threat stays open on purpose. <a href="#patel-arrests-soon">See the card</a>.</span>
            </li>
            <li>
              <span class="watch-when">Oct–Nov 2026</span>
              <span class="watch-what"><strong>An "election emergency."</strong> Trump's own former White House special counsel says the primetime address was built "to add the predicate" for declaring an emergency at election time. If one is declared, the machinery in the emergency-powers card is what it runs on. <a href="#emergency-powers-track">See the card</a>.</span>
            </li>
            <li>
              <span class="watch-when">Nov 3, 2026</span>
              <span class="watch-what"><strong>Election Day.</strong> Trump has said he will accept the results "if they are honest" — and that if not, "something else has to happen." <a href="#nationalize-voting">See the card</a>.</span>
            </li>
          </ul>
        </div>
      </section>

      <!-- ── PROTECT THE VOTE ─────────────────────────────────────────── -->
      <section id="protect" aria-label="Protect the vote">
        <div class="wrap">
          <div class="sec-head">
            <p class="kicker">Before you leave this page</p>
            <h2>Protect the vote</h2>
            <p class="sub">Documentation only matters if it moves you to act. None of this requires a side. It requires that you can vote, that you know your rights, and that you can check this record for yourself.</p>
          </div>
          <div class="protect-grid">
            <div class="protect-card">
              <span class="protect-num">01</span>
              <h3>Make sure you can vote</h3>
              <p>Confirm your registration, or register, at <a href="https://vote.gov/" target="_blank" rel="noopener noreferrer">vote.gov</a>, the official federal portal. Check your state's deadlines, ID rules, and mail-ballot options at <a href="https://www.canivote.org/" target="_blank" rel="noopener noreferrer">CanIVote.org</a>, run by the bipartisan National Association of Secretaries of State.</p>
              <p class="protect-note">The rules are changing this cycle, see the SAVE Act and mail-ballot cards above. Check again close to the election.</p>
            </div>
            <div class="protect-card">
              <span class="protect-num">02</span>
              <h3>If someone tries to stop you</h3>
              <p>Voter intimidation and being wrongly turned away are illegal. Call the nonpartisan Election Protection hotline, staffed by volunteer lawyers:</p>
              <p class="protect-hotline"><strong>866-OUR-VOTE</strong> <span>(866-687-8683)</span><br /><strong>888-VE-Y-VOTA</strong> <span>en español (888-839-8682)</span></p>
              <p class="protect-note">Report problems to your state or county election office. If you are in line when polls close, stay, you have the right to vote.</p>
            </div>
            <div class="protect-card">
              <span class="protect-num">03</span>
              <h3>Check our work, then share it</h3>
              <p>Every card on this page links to its sources. Don't take our word for it, read them and decide for yourself.</p>
              <p>Then send someone the receipt, not just the headline: open any entry and use <strong>Copy link to this entry</strong> to share that specific record.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ── METHOD ───────────────────────────────────────────────────── -->
      <section id="method" aria-label="Method">
        <div class="wrap">
          <div class="sec-head">
            <p class="kicker">Standards</p>
            <h2>Method</h2>
          </div>
          <div class="method-grid">
            <div class="method-card">
              <h3>What gets included</h3>
              <ul>
                <li>Actions by Trump, his administration, or allies he directed, endorsed, or enabled, aimed at the machinery, rules, personnel, or legitimacy of the 2026 midterms.</li>
                <li>Not included: ordinary partisan politics, campaigning, or policies we merely disagree with.</li>
                <li>Statements count when they are threats, directives, or admissions — and they are labeled "On the Record," not treated as completed acts.</li>
              </ul>
            </div>
            <div class="method-card">
              <h3>Sourcing rules</h3>
              <ul>
                <li>Every card links to its sources; nearly all claims carry two or more independent outlets, including right-leaning outlets when they covered the story.</li>
                <li>Single-sourced items are noted as such in the card.</li>
                <li>We use the most precise language the evidence supports — "blocked" is not "killed," "reported" is not "proven."</li>
                <li>Corrections are made openly, not quietly.</li>
              </ul>
            </div>
            <div class="method-card">
              <h3>One standard for everyone</h3>
              <ul>
                <li>A claim that an election was stolen requires evidence, no matter who makes it or who it benefits.</li>
                <li>That is the standard by which 60+ courts, Trump's own attorney general, and his own cybersecurity agency rejected the 2020 fraud claims. It is the same standard we would apply to any fraud claim about 2024 or 2026, including from people who oppose Trump.</li>
                <li>This page documents actions that are themselves documented — orders signed, words spoken, suits filed — not statistical inferences about secret manipulation.</li>
              </ul>
            </div>
            <div class="method-card">
              <h3>Flag criteria</h3>
              <ul>
                <li><strong>Unprecedented</strong> is applied only where the cited officials, experts, or reporting say an action has no equivalent, and the card states that basis.</li>
                <li><strong>Ruled Unlawful</strong> means a court has ruled against the action itself.</li>
                <li><strong>Prohibited by Law</strong> means the action conflicts with explicit statute or a standing court order.</li>
                <li><strong>Constitutional Conflict</strong> means the action collides with constitutional text or the Constitution's allocation of power, per the litigation and experts cited. Courts may not have ruled yet, and we say so.</li>
                <li><strong>The trust counter</strong> in the header totals entries, {history.length} from the 2020–2025 prehistory plus {doubtCount} from the 2026 record, in which Trump or his administration publicly asserted that American elections are rigged, fraudulent, or illegitimate, or acted publicly to delegitimize a result. One entry can bundle many statements, so the count is conservative.</li>
              </ul>
            </div>
            <div class="method-card">
              <h3>Status definitions</h3>
              <ul>
                <li><strong>In Effect</strong> — happened or currently operating.</li>
                <li><strong>In Court</strong> — operative or contested, with litigation pending.</li>
                <li><strong>Blocked</strong> — stopped by courts, or abandoned after failing.</li>
                <li><strong>Threatened</strong> — announced or planned, not yet executed.</li>
                <li><strong>On the Record</strong> — a statement, directive, or admission in the speaker's own words.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap foot-inner">
        <p class="foot-note">
          Rigged Before the Vote is an independent documentation project. Facts are sourced;
          opinions are labeled. Found an error? We correct openly — every claim links to its source
          so you can check us.
        </p>
        <div class="foot-links">
          <a href="https://thetrumptracker.com" target="_blank" rel="noopener noreferrer">From the team behind The Trump Tracker ↗</a>
          <a href="#top">Back to top ↑</a>
        </div>
      </div>
    </footer>

    <script>
      // ── countdown to Election Day (Nov 3, 2026) ──
      const eday = new Date(2026, 10, 3);
      const days = Math.max(0, Math.ceil((eday - new Date()) / 86400000));
      document.getElementById('days-out').textContent = days;
      document.getElementById('days-out-big').textContent = days;

      // ── count-up animation on hero stats ──
      const animate = (el) => {
        const target = +el.dataset.count;
        const dur = 900;
        const t0 = performance.now();
        const tick = (t) => {
          const p = Math.min(1, (t - t0) / dur);
          el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3)));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { reduce ? (e.target.textContent = e.target.dataset.count) : animate(e.target); io.unobserve(e.target); }
        });
      });
      document.querySelectorAll('[data-count]').forEach((el) => io.observe(el));

      // ── filtering ──
      let activeCat = 'all';
      let activeStatus = 'all';
      let activeFlag = 'all';
      const cards = [...document.querySelectorAll('.card')];
      const shownCount = document.getElementById('shown-count');

      const applyFilters = () => {
        let shown = 0;
        cards.forEach((c) => {
          const flagOk = activeFlag === 'all'
                  || (activeFlag === 'unprec' && c.dataset.unprec)
                  || (activeFlag === 'legal' && c.dataset.legal)
                  || (activeFlag === 'doubt' && c.dataset.doubt);
          const ok = (activeCat === 'all' || c.dataset.cat === activeCat)
                  && (activeStatus === 'all' || c.dataset.status === activeStatus)
                  && flagOk;
          c.classList.toggle('is-hidden', !ok);
          if (ok) shown++;
        });
        shownCount.textContent = shown;
      };

      document.querySelectorAll('[data-cat]').forEach((chip) => {
        if (chip.classList.contains('card')) return;
        chip.addEventListener('click', () => {
          activeCat = chip.dataset.cat;
          document.querySelectorAll('.chip[data-cat]').forEach((c) => c.classList.toggle('is-on', c === chip));
          applyFilters();
        });
      });
      document.querySelectorAll('.chip[data-status]').forEach((chip) => {
        chip.addEventListener('click', () => {
          activeStatus = chip.dataset.status;
          document.querySelectorAll('.chip[data-status]').forEach((c) => c.classList.toggle('is-on', c === chip));
          applyFilters();
        });
      });
      document.querySelectorAll('.chip[data-flag]').forEach((chip) => {
        chip.addEventListener('click', () => {
          activeFlag = chip.dataset.flag;
          document.querySelectorAll('.chip[data-flag]').forEach((c) => c.classList.toggle('is-on', c === chip));
          applyFilters();
        });
      });

      // flag tiles jump + filter
      document.querySelectorAll('[data-goto-flag]').forEach((tile) => {
        tile.addEventListener('click', () => {
          document.querySelector(`.chip[data-flag="${tile.dataset.gotoFlag}"]`)?.click();
          document.getElementById('record').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
        });
      });

      // hero status tiles jump + filter
      document.querySelectorAll('[data-goto-status]').forEach((tile) => {
        tile.addEventListener('click', () => {
          document.querySelector('.chip[data-cat="all"]')?.click();
          document.querySelector('.chip[data-flag="all"]')?.click();
          document.querySelector(`.chip[data-status="${tile.dataset.gotoStatus}"]`)?.click();
          document.getElementById('record').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
        });
      });

      // hero "documented actions" tile — reset all filters, jump to record
      document.querySelectorAll('[data-goto-all]').forEach((tile) => {
        tile.addEventListener('click', () => {
          document.querySelector('.chip[data-cat="all"]')?.click();
          document.querySelector('.chip[data-status="all"]')?.click();
          document.querySelector('.chip[data-flag="all"]')?.click();
          document.getElementById('record').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
        });
      });

      // ── copy link to a specific entry (event-delegated) ──
      document.getElementById('cards').addEventListener('click', (e) => {
        const btn = e.target.closest('.share-btn');
        if (!btn) return;
        e.preventDefault();
        const url = location.origin + location.pathname + '#' + btn.dataset.share;
        const done = () => { const t = btn.textContent; btn.textContent = 'Link copied ✓'; btn.classList.add('copied'); setTimeout(() => { btn.textContent = t; btn.classList.remove('copied'); }, 1800); };
        if (navigator.clipboard?.writeText) {
          navigator.clipboard.writeText(url).then(done).catch(() => { location.hash = btn.dataset.share; done(); });
        } else {
          location.hash = btn.dataset.share; done();
        }
      });

      // ── doubt-band filter link ──
      document.getElementById('doubt-filter-btn').addEventListener('click', () => {
        document.querySelector('.chip[data-flag="doubt"]')?.click();
        document.getElementById('record').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
      });

      // category tiles jump + filter
      document.querySelectorAll('[data-goto-cat]').forEach((tile) => {
        tile.addEventListener('click', () => {
          const slug = tile.dataset.gotoCat;
          const chip = document.querySelector(`.chip[data-cat="${slug}"]`);
          chip?.click();
          document.getElementById('record').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
        });
      });

      // ── sort toggle ──
      let newestFirst = true;
      const grid = document.getElementById('cards');
      document.getElementById('sort-toggle').addEventListener('click', (e) => {
        newestFirst = !newestFirst;
        e.target.textContent = newestFirst ? 'Newest first ↓' : 'Oldest first ↑';
        [...grid.children]
          .sort((a, b) => (newestFirst ? b.dataset.date.localeCompare(a.dataset.date) : a.dataset.date.localeCompare(b.dataset.date)))
          .forEach((el) => grid.appendChild(el));
      });

      // ── open card when deep-linked (#card-id) ──
      const openFromHash = () => {
        const el = document.getElementById(location.hash.slice(1));
        if (!el?.classList.contains('card')) return;
        if (el.classList.contains('is-hidden')) {
          document.querySelector('.chip[data-cat="all"]')?.click();
          document.querySelector('.chip[data-status="all"]')?.click();
          document.querySelector('.chip[data-flag="all"]')?.click();
        }
        el.open = true;
        el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      };
      window.addEventListener('hashchange', openFromHash);
      if (location.hash) openFromHash();

      // ── scroll-spy topbar ──
      const navLinks = [...document.querySelectorAll('.topnav a')];
      const spy = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            navLinks.forEach((l) => l.classList.toggle('is-active', l.getAttribute('href') === '#' + e.target.id));
          }
        });
      }, { rootMargin: '-30% 0px -60% 0px' });
      ['record', 'prehistory', 'sequence', 'pattern', 'watch', 'protect', 'method'].forEach((id) => {
        const el = document.getElementById(id);
        if (el) spy.observe(el);
      });
    </script>
  </body>
</html>
